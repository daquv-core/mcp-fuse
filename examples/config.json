{
  "listen": "127.0.0.1:8080",
  "resource": "https://mcp.example.com/mcp",
  "authorization_servers": ["https://auth.example.com"],
  "auth": {
    "introspection_url": "https://auth.example.com/oauth/introspect",
    "client_id": "mcp-fuse",
    "client_secret_file": "/etc/mcp-fuse/introspection-secret"
  },
  "state_file": "/var/lib/mcp-fuse/state.bin",
  "secret_file": "/etc/mcp-fuse/secret",
  "backends": [
    {"name": "orders", "url": "https://orders.example.com/mcp"},
    {"name": "analytics", "url": "https://analytics.example.com/mcp",
     "client_id": "mcp-fuse", "client_secret_file": "/etc/mcp-fuse/analytics-client-secret"}
  ],
  "list_timeout_seconds": 15
}
